{
  "manifest_version": 3,
  "name": "Nolia",
  "version": "0.5.3",
  "description": "Assistance linguistique locale et contrôlée pour l'environnement de test Safinum.",
  "action": {
    "default_title": "Nolia"
  },
  "content_scripts": [
    {
      "matches": [
        "https://safinum.cm/hackathon-test",
        "https://safinum.cm/hackathon-test/*"
      ],
      "js": [
        "extension/content-script.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "core/*.js"
      ],
      "matches": [
        "https://safinum.cm/*"
      ]
    }
  ]
}
